        "arguments": "-DCMAKE_BUILD_TYPE=Release",
        "cppFlags": "-std=c++17",
        "abiFilters": [
          "arm64-v8a"
        ]
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    }
  ]
}
